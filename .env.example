# Capital.com API
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_DEMO_URL=https://demo-api-capital.backend-capital.com

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trading_ai
DB_USER=root
DB_PASSWORD=

# Trade mode: scalping, day_trading, swing
TRADE_MODE=swing

# Auto-trade: true = place orders on Capital.com, false = signals only
AUTO_TRADE=false

# Position size per symbol (contracts)
# XAUUSD: 1 contract = 1 oz of gold
# BTCUSD: 1 contract = 1 BTC
TRADE_SIZE_XAUUSD=0.1
TRADE_SIZE_BTCUSD=0.01

# Symbols (comma-separated): XAUUSD, BTCUSD
SYMBOLS=BTCUSD

# Logging
LOG_LEVEL=INFO