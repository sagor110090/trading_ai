# ==================== TRADING PLATFORM ====================
# Options: CAPITAL, MT5
TRADING_PLATFORM=MT5

# ==================== CAPITAL.COM SETTINGS ====================
# Capital.com API
CAPITAL_API_KEY=b3XJpRBS2u9XY0iq
CAPITAL_IDENTIFIER=mehedihasansagor.cse@gmail.com
CAPITAL_PASSWORD=@Sagor110090
CAPITAL_USE_DEMO=true
CAPITAL_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_DEMO_URL=https://demo-api-capital.backend-capital.com

# ==================== METATRADER 5 SETTINGS ====================
# MT5 Settings (only used if TRADING_PLATFORM=MT5)
# Note: MT5 terminal must be running and logged in
MT5_LOGIN=411987023
MT5_PASSWORD=Sagor110090@
MT5_SERVER=Exness-MT5Real8

# ==================== DATABASE SETTINGS ====================
# Choose database type: set USE_SQLITE=false for MySQL, true for SQLite
USE_SQLITE=true
SQLITE_DB_PATH=trading_ai.db

# MySQL settings (used when USE_SQLITE=false)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trading_ai
DB_USER=root
DB_PASSWORD=

# ==================== TRADING SETTINGS ====================
# Trade mode: scalping, day_trading, swing
TRADE_MODE=day_trading

# Auto-trade: true = place orders, false = signals only
AUTO_TRADE=true

# Trailing stop: true = move SL at profit milestones, false = disable trailing
TRAILING_STOP_ENABLED=false

# Position size per symbol (contracts/lots)
# For MT5: volume in lots (check broker requirements)
# For Capital.com: contracts
TRADE_SIZE_DEFAULT=0.01
TRADE_SIZE_XAUUSD=0.01
TRADE_SIZE_BTCUSD=0.01
TRADE_SIZE_US30=0.01
TRADE_SIZE_AUDUSD=0.05
TRADE_SIZE_XAGUSD=0.01

# SL/TP multipliers per symbol (multiplied by ATR14 to calculate SL/TP distance)
# Forex pairs need wider stops (15-25 pips) to avoid noise hits
# Metals use moderate stops (10-20 points) due to higher volatility
# Crypto (BTCUSD) uses tighter stops as it works well for current volatility
# Values below are optimized for day_trading mode
SL_MULTIPLIER_XAUUSD=1.0
TP_MULTIPLIER_XAUUSD=1.8
SL_MULTIPLIER_XAGUSD=1.0
TP_MULTIPLIER_XAGUSD=1.8
SL_MULTIPLIER_BTCUSD=0.7
TP_MULTIPLIER_BTCUSD=1.2
SL_MULTIPLIER_EURUSD=2.0
TP_MULTIPLIER_EURUSD=3.0
SL_MULTIPLIER_AUDUSD=2.0
TP_MULTIPLIER_AUDUSD=3.0
SL_MULTIPLIER_US30=2.0
TP_MULTIPLIER_US30=3.0


# Symbols (comma-separated)
# Current performers: BTCUSD (44% win), XAUUSD (43% win)
# Testing: ETHUSD (crypto), USDCAD, AUDUSD (cleaner forex trends), XAGUSD (Silver)
SYMBOLS=BTCUSD,XAUUSD,XAGUSD,AUDUSD,EURUSD,US30
# ,US30,AUDUSD,

# ML prediction threshold: trades with ML probability below this are blocked
# 0.0 = disabled (take all), 0.3 = moderate filter, 0.5 = strict
# Default threshold (used if no symbol-specific threshold is set)
ML_PREDICTION_THRESHOLD=0.6
# Per-symbol thresholds (overrides default for specific symbols)
 # Based on actual ML performance (ROC AUC)
  ML_PREDICTION_THRESHOLD_BTCUSD=0.50    # Weak model (ROC AUC 0.59) - lower threshold
  ML_PREDICTION_THRESHOLD_XAUUSD=0.55    # Moderate model (ROC AUC 0.64) - keep current
  ML_PREDICTION_THRESHOLD_US30=0.45      # Good model (ROC AUC 0.65) - raise from 0.30
  ML_PREDICTION_THRESHOLD_AUDUSD=0.50    # Good model (ROC AUC 0.69) - raise slightly
  ML_PREDICTION_THRESHOLD_XAGUSD=0.60    # Best model (ROC AUC 0.70) - raise for quality
  ML_PREDICTION_THRESHOLD_EURUSD=0.50    # Good model (ROC AUC 0.69) - raise slightly

# Auto-train ML models during live trading
# false = train only via backtest (recommended), true = auto-train during live runs
ML_AUTO_TRAIN=false

# Seconds between live trading cycles
# Recommended: scalping=60-120, day_trading=300, swing=900
RUN_INTERVAL=300

# Position monitor interval (seconds)
# How often to check open positions for TP progress and strength exits
# Recommended: 30-60 seconds
POSITION_MONITOR_INTERVAL=10

# Logging
LOG_LEVEL=INFO

# ==================== BROKER SETTINGS ====================
# Broker execution speed/spread in pips (automatically added to SL/TP calculations)
# This accounts for execution latency and ensures SL/TP are not missed due to broker delay
# Recommended: 0.10-0.30 pips for most brokers
BROKER_SPREAD_PIPS=0.10

# ==================== VERIFICATION SETTINGS ====================
# Dynamic verification window based on trade mode
# true = use max_hold_minutes / 5 for M5 candles (recommended)
# false = use static 100 candles
DYNAMIC_LOOKAHEAD=true

# ==================== CORRELATION LIMIT SETTINGS ====================
# Max positions per correlation group (prevents overexposure)
# Recommended: 1 for metals/crypto, 2 for forex groups
MAX_POSITIONS_CRYPTO=1
MAX_POSITIONS_METALS=1
MAX_POSITIONS_FOREX_MAJOR=2
MAX_POSITIONS_FOREX_MINOR=2
MAX_POSITIONS_INDICES=1

# ==================== ML DRIFT DETECTION SETTINGS ====================
# Minimum predictions before checking for model drift
ML_MIN_SIGNALS_FOR_DRIFT=20

# Drift threshold: alert if win rate drops below (training_auc - threshold)
# 0.15 = 15% below expected, 0.10 = more sensitive, 0.20 = less sensitive
ML_DRIFT_THRESHOLD=0.15

# Enable/disable drift detection
ML_DRIFT_DETECTION_ENABLED=true

# ==================== WEEKLY CLOSE SETTINGS ====================
# Weekly market close handling for forex, metals, and indices
# Crypto markets (BTCUSD, ETHUSD, etc.) are 24/7 and NOT affected
# Time values are in decimal hours: 0.5 = 30 min, 2.0 = 2 hours
#
# EXNESS MARKET HOURS (Bangladesh Time, UTC+6):
# - Forex (EURUSD, GBPUSD, etc.): Close Saturday 02:59 AM BST, Open Monday 03:05 AM BST
# - Gold (XAUUSD): Close Saturday 02:58 AM BST, Open Monday 04:05 AM BST

# Enable/disable weekly close handling
WEEKLY_CLOSE_ENABLED=true

# Hours before close to stop NEW trades (2.0 hours before weekly close)
WEEKLY_CLOSE_STOP_NEW_TRADES_HOURS=2.0

# Hours before close to close EXISTING positions (0.5 hours before weekly close)
WEEKLY_CLOSE_CLOSE_POSITIONS_HOURS=0.5


#   ML_PREDICTION_THRESHOLD_BTCUSD=0.4    ✅ Keep - good balance
#   ML_PREDICTION_THRESHOLD_XAUUSD=0.6    ✅ Keep - high threshold compensates for low precision
#   ML_PREDICTION_THRESHOLD_US30=0.3      ✅ Keep - best performer, can afford low threshold
#   ML_PREDICTION_THRESHOLD_AUDUSD=0.5    ⬆️ Raise from 0.4 - model is weak (26% precision)
#   ML_PREDICTION_THRESHOLD_XAGUSD=0.7    ⬆️ Very high - NO model trained yet!