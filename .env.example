# =====================================================================
# TRADING AI — CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Remove the # to enable an option.
# =====================================================================


# ==================== 1. BROKER (MetaTrader 5) ====================
# MT5 terminal must be running and logged in on this machine.
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER


# ==================== 2. DATABASE ====================
# SQLite (simple, no setup) or MySQL (better for heavy backtesting).
USE_SQLITE=true
SQLITE_DB_PATH=trading_ai.db

# MySQL settings (only used when USE_SQLITE=false)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trading_ai
DB_USER=root
DB_PASSWORD=


# ==================== 3. SYMBOLS & STRATEGY ====================
# Which symbols to trade (comma-separated).
# Must be one of: XAUUSD, BTCUSD
#
#   XAUUSD  Gold     — METALS group, weekday trading only, weekly close ON
#   BTCUSD  Bitcoin  — CRYPTO group, trades 24/7, no weekly close
#
# Each symbol uses its OWN strategy profile (weights, SL/TP, ML threshold).
# See section 4 below to customize each one independently.
SYMBOLS=XAUUSD,BTCUSD


# -------------------- 4. PER-SYMBOL TRADING CONFIG --------------------
# Every setting below can be set independently for each symbol using
# the _XAUUSD / _BTCUSD suffix. This is how the two pairs run different
# strategies at the same time.
#
# Quick reference (current tuned defaults):
#
#   Setting             XAUUSD (Gold)    BTCUSD (Bitcoin)   Why different
#   ------------------  --------------   ----------------   ---------------------------
#   SL multiplier       1.5  (wide)      0.7  (tight)       Gold mean-reverts; BTC trends
#   TP multiplier       2.7              1.2                R:R >= 1.5 for both
#   Trade size (lots)   0.05             0.01               BTC is ~30x more volatile
#   ML threshold        0.45             0.40               Tuned to each model's AUC
#   Factor weights      RSI+structure    trend+momentum     See section 9 to override

# --- Position size (lots) ---
TRADE_SIZE_DEFAULT=0.01
TRADE_SIZE_XAUUSD=0.05
TRADE_SIZE_BTCUSD=0.01

# --- SL/TP multipliers (x ATR14 distance) ---
# Gold: wide stops because 70%+ SL-hit rate at tight stops
# BTC:  SL widened 0.7 -> 0.8 (typical adverse excursion ~0.74 ATR was tagging
#       the 0.7 SL too early — 61% SL-hit). MFE/MAE sim shows 0.8/1.2 is the
#       robust-profitable combo; keep TP=1.2 (BTC rarely reaches it).
SL_MULTIPLIER_XAUUSD=1.5
TP_MULTIPLIER_XAUUSD=2.7
SL_MULTIPLIER_BTCUSD=0.8
TP_MULTIPLIER_BTCUSD=1.2

# --- ML prediction threshold (probability of WIN required to trade) ---
# Below threshold     = trade blocked entirely
# Above/equal threshold = trade at full size (approved)
ML_PREDICTION_THRESHOLD=0.5
ML_PREDICTION_THRESHOLD_XAUUSD=0.45
ML_PREDICTION_THRESHOLD_BTCUSD=0.40


# -------------------- 5. GENERAL TRADING --------------------
# Auto-trade: true = place real orders, false = signals only (paper mode)
AUTO_TRADE=true

# Trailing stop: true = move SL toward profit as price moves favorably
TRAILING_STOP_ENABLED=false

# Trade mode is fixed to day_trading (this line is kept for backward compat)
TRADE_MODE=day_trading


# -------------------- 6. ML PIPELINE --------------------
# All enhancements are ON by default. Disable individually if needed.

# SMOTE: balance WIN/LOSS class imbalance with synthetic samples (train only)
ML_USE_SMOTE=true

# Optuna: Bayesian hyperparameter search (50 trials per model)
ML_USE_TUNING=true

# Calibration: Platt scaling so predict_proba outputs are accurate
ML_USE_CALIBRATION=true

# Feature selection: drop <1% importance features, retrain simpler model
ML_USE_FEATURE_SELECTION=true

# Auto-train during live runs (false = train only via backtest, recommended)
ML_AUTO_TRAIN=false


# -------------------- 7. SCHEDULING --------------------
# Seconds between live trading cycles (300 = check every 5 min)
RUN_INTERVAL=300

# How often to monitor open positions for exits (seconds)
POSITION_MONITOR_INTERVAL=10


# -------------------- 8. RISK MANAGEMENT --------------------

# Force-close trades that exceed max hold time (minutes)
POSITION_TIMEOUT_ENABLED=true
# 0 = use day_trading default (240 min). Set a number to override.
POSITION_TIMEOUT_MINUTES=0

# Broker spread buffer added to SL (pips) — prevents premature stop-outs
BROKER_SPREAD_PIPS=0.10

# Fast market: when ATR ratio >= 1.5, halve SL/TP distances to cut risk
FAST_MARKET_SL_TP_FACTOR=0.5

# Max positions per correlation group (1 = only 1 metals + 1 crypto at a time)
MAX_POSITIONS_METALS=1
MAX_POSITIONS_CRYPTO=1

# Optional: cap max SL/TP distance in price units (uncomment to enable)
# Prevents runaway risk when ATR spikes. Examples:
# MAX_SL_DISTANCE_XAUUSD=30
# MAX_TP_DISTANCE_XAUUSD=50
# MAX_SL_DISTANCE_BTCUSD=1000
# MAX_TP_DISTANCE_BTCUSD=1500


# -------------------- 9. PER-SYMBOL STRATEGY WEIGHTS --------------------
# These define HOW each symbol is scored. Each pair uses a different bias:
#
#   XAUUSD (Gold)    -> structure + RSI heavy  (respects levels, mean-reverts)
#   BTCUSD (Bitcoin) -> trend + momentum heavy (trends hard, noisy)
#
# Weights should sum to ~100 per symbol. Edit values to tune the strategy.
# If you delete a line, the code default (same value) is used instead.

# --- XAUUSD (Gold): structure + RSI bias ---
# Gold respects technical levels and mean-reverts from extremes.
SYMBOL_WEIGHT_XAUUSD_EMA_TREND=28
SYMBOL_WEIGHT_XAUUSD_RSI=18
SYMBOL_WEIGHT_XAUUSD_MACD=18
SYMBOL_WEIGHT_XAUUSD_ATR=10
SYMBOL_WEIGHT_XAUUSD_STRUCTURE=16
SYMBOL_WEIGHT_XAUUSD_MOMENTUM=10

# --- BTCUSD (Bitcoin): trend + momentum bias ---
# Crypto trends hard with fakeouts; momentum confirms real moves.
SYMBOL_WEIGHT_BTCUSD_EMA_TREND=34
SYMBOL_WEIGHT_BTCUSD_RSI=10
SYMBOL_WEIGHT_BTCUSD_MACD=22
SYMBOL_WEIGHT_BTCUSD_ATR=8
SYMBOL_WEIGHT_BTCUSD_STRUCTURE=10
SYMBOL_WEIGHT_BTCUSD_MOMENTUM=16

# --- Per-symbol rule thresholds (how confident the signal must be) ---
# Minimum score (out of 100) required to trigger BUY / SELL.
SYMBOL_THRESHOLD_XAUUSD_BUY_THRESHOLD=40
SYMBOL_THRESHOLD_XAUUSD_SELL_THRESHOLD=40
SYMBOL_THRESHOLD_BTCUSD_BUY_THRESHOLD=45
SYMBOL_THRESHOLD_BTCUSD_SELL_THRESHOLD=45


# -------------------- 10. VERIFICATION & DRIFT --------------------
# Dynamic lookahead window based on max hold time (recommended)
DYNAMIC_LOOKAHEAD=true

# ML drift detection: alert if live win rate drops well below training AUC
ML_DRIFT_DETECTION_ENABLED=true
ML_MIN_SIGNALS_FOR_DRIFT=20
ML_DRIFT_THRESHOLD=0.15


# -------------------- 11. WEEKLY CLOSE (Gold only) --------------------
# Crypto (BTCUSD) trades 24/7 and is NOT affected by these settings.
# Gold closes for the weekend — the bot stops new trades and closes
# existing positions before the market shuts.
#
# EXNESS GOLD HOURS (Bangladesh Time, UTC+6):
#   Close: Saturday 02:58 AM   Open: Monday 04:05 AM
WEEKLY_CLOSE_ENABLED=true
# Hours before close to stop opening NEW trades
WEEKLY_CLOSE_STOP_NEW_TRADES_HOURS=2.0
# Hours before close to CLOSE EXISTING positions
WEEKLY_CLOSE_CLOSE_POSITIONS_HOURS=0.5


# -------------------- 12. LOGGING --------------------
LOG_LEVEL=INFO
